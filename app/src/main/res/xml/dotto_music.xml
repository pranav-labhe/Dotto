<?xml version="1.0" encoding="utf-8"?>
<dottoMusic>

    <!-- 1. Landing / Settings: "Lofi/Chill" - Gen Z friendly -->
    <track id="landing" tempo="60" root="D" scale="major">
        <bass waveform="sine" octave="2" volume="0.2" />
        <pad waveform="sine" attack="3.0" release="6.0" volume="0.3" wobble="0.4" />
        <arpeggio pattern="1,5,8,12,10,8,5,1,8,15,17,15,8,12,1,5,8,13,10,8" noteLength="seventh" volume="0.4" />
    </track>
    <!-- 1. Landing / Settings: Spacious, ambient, deep sub-bass
      <track id="landing" tempo="68" root="D" scale="minor">
          <bass waveform="sine" octave="1" volume="0.2" />
          <pad waveform="sine" attack="3.0" release="5.0" volume="0.5" />
          <arpeggio pattern="1,5,8,7,4,2,1,8,9,10,9,7" noteLength="quarter" volume="0.8" />
      </track> -->

    <!-- 2. Game Screen: Driving arpeggios, focused rhythm - Flow matched to Landing -->
    <track id="game" tempo="72" root="D" scale="minor">
        <bass waveform="sine" octave="1" volume="0.4" />
        <pad waveform="sine"
            attack="2.5"
            release="5.5"
            volume="0.28"
            wobble="0.65" />
        <arpeggio
            pattern="1,5,8,5,1,8,12,8,5,1,10,13,10,5,8,12,17,12,8,5"
            noteLength="fifth"
            volume="0.60" />
    </track>

    <!-- 3. Success: Bright arpeggios, uplifting -->
    <track id="success" tempo="80" root="D" scale="dorian">
        <bass waveform="sine" octave="2" volume="0.4" />
        <pad waveform="sine" attack="0.5" release="2.0" volume="0.3" />
        <arpeggio pattern="1,5,8,10,12" noteLength="sixteenth" volume="0.2" />
    </track>

    <!-- 4. Failure: Dark sine bass, somber -->
    <track id="failure" tempo="60" root="D" scale="phrygian">
        <bass waveform="sine" octave="0" volume="0.7" />
        <pad waveform="sine" attack="5.0" release="8.0" volume="0.1" />
        <arpeggio pattern="1,2,1" noteLength="half" volume="0.05" />
    </track>
</dottoMusic>
