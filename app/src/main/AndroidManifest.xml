<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.VIBRATE" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/Theme.Dotto"
        android:supportsRtl="true"
        tools:targetApi="34"
        xmlns:tools="http://schemas.android.com/tools">

        <meta-data
            android:name="com.google.android.gms.ads.APPLICATION_ID"
            android:value="ca-app-pub-3940256099942544~3347511713" />

        <!--
            No <uses-permission> entries: Dotto requires zero network,
            storage, or other permissions to play. This is intentional —
            see "No Server" / airplane-mode requirement in the design brief.
        -->

        <activity
            android:name="com.pranav.dotto.MainActivity"
            android:exported="true"
            android:theme="@style/Theme.Dotto">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
